func load_texture(file_name: String) -> Texture2D:
    return ASSETS.get(file_name) as Texture2D

func has_asset(file_name: String) -> bool:
    return ASSETS.has(file_name)

func get_asset_count() -> int:
    return ASSETS.size()

func validate_manifest(data: Dictionary) -> Array[String]:
    var failures: Array[String] = []
    for entry: Variant in data.get("assets", []):
        if not entry is Dictionary:
            failures.append("Invalid asset manifest entry.")
            continue
        var file_name := str(entry.get("path", "")).get_file()
        if not ASSETS.has(file_name):
            failures.append("Asset is not registered for Android export: " + file_name)
        elif ASSETS[file_name] == null:
            failures.append("Asset preload is null: " + file_name)
    return failures
